# Server
PORT=3001

# API Key for authenticating agent events (X-ClaWatch-Key header)
API_KEY=clawatch-dev-key

# Telegram Bot (optional — alerts still saved to DB without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard URL (used in Telegram inline buttons)
DASHBOARD_URL=http://localhost:5173

# OpenClaw JSONL directory (defaults to ~/.openclaw)
OPENCLAW_DIR=

# Alert thresholds
STUCK_TIMEOUT_MS=300000
ERROR_SPIKE_THRESHOLD=3
ERROR_SPIKE_WINDOW_MS=60000
COST_THRESHOLD_USD=10
