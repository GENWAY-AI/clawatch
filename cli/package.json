{
  "name": "clawatch",
  "version": "1.2.2",
  "description": "Observability & monitoring for AI agents. Track costs, tokens, sessions, and get alerts when things go wrong.",
  "author": "GENWAY AI <hello@genway.ai>",
  "license": "MIT",
  "homepage": "https://clawatch.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GENWAY-AI/clawatch.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/GENWAY-AI/clawatch/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "observability",
    "monitoring",
    "openclaw",
    "llm",
    "cost-tracking",
    "opentelemetry"
  ],
  "main": "dist/cli.js",
  "bin": {
    "clawatch": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "backend/**/*",
    "frontend/**/*",
    "frontend/.next/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bash ../scripts/build-npm.sh",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "postinstall": "echo 'ClaWatch installed successfully (pure WASM \u2014 no native build needed)'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.1"
  }
}